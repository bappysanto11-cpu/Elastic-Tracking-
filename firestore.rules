rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own user profile and data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /sheets/{sheetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /history/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Global tracking collections (accessible for real-time factory operations)
    match /scheduleItems/{document=**} {
      allow read, write: if true;
    }
    match /progressLogs/{document=**} {
      allow read, write: if true;
    }
    match /challanDetails/{document=**} {
      allow read, write: if true;
    }
    match /truckDispatch/{document=**} {
      allow read, write: if true;
    }
  }
}
